  <svg viewBox="0 0 240 22" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round">
    <path d="M0 11h40" opacity=".6" />
    <path d="M200 11h40" opacity=".6" />
    <g transform="translate(40 0)">
      <path d="M0 11l10-10 10 10-10 10zM20 11l10-10 10 10-10 10zM40 11l10-10 10 10-10 10zM60 11l10-10 10 10-10 10zM80 11l10-10 10 10-10 10zM100 11l10-10 10 10-10 10zM120 11l10-10 10 10-10 10zM140 11l10-10 10 10-10 10z" />
      <path d="M10 6l5 5-5 5-5-5zM30 6l5 5-5 5-5-5zM50 6l5 5-5 5-5-5zM70 6l5 5-5 5-5-5zM90 6l5 5-5 5-5-5zM110 6l5 5-5 5-5-5zM130 6l5 5-5 5-5-5zM150 6l5 5-5 5-5-5z" opacity=".7" />
    </g>
  </svg>
</div>
