---
import Layout from '../components/Layout.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import Filmstrip from '../components/Filmstrip.astro';
import { path, useT, digits, type Lang } from '../i18n';
import { ROOMS, SITE } from '../data/site';
import { photo } from '../data/photos';
import { waUrl } from '../lib/wa';
import en from '../i18n/en.json';
import ar from '../i18n/ar.json';
interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const { t } = useT(lang);
const room = ROOMS.find((r) => r.id === id)!;
const name = t(`rooms.${id}.name`);
const steps: string[] = ((lang === 'ar' ? ar : en) as any).rooms[id].steps;
// walk-through: pair each step with a photo from the room's list (bathroom photos last)
const walkPhotos = room.photos.filter((p) => photo(p).group !== 'bathroom').concat(room.photos.filter((p) => photo(p).group === 'bathroom'));
const walk = steps.map((s, i) => ({ text: s, photo: walkPhotos[Math.min(i, walkPhotos.length - 1)] }));
const others = ROOMS.filter((r) => r.id !== id);
const wa = waUrl(`${t('enquire.waIntro')} ${t('enquire.waRoom')}: ${name}.`);
const amen = [
  { icon: 'ac', key: 'ac' }, { icon: 'wifi', key: 'wifi' }, { icon: 'shower', key: 'shower' }, { icon: 'kettle', key: 'kettle' }, { icon: 'towel', key: 'towels' }, { icon: 'wardrobe', key: 'wardrobe' },
] as const;
const amenLabel: Record<string, { en: string; ar: string }> = {
  ac: { en: 'Air conditioning', ar: 'تكييف' }, wifi: { en: 'Wi‑Fi', ar: 'واي فاي' }, shower: { en: 'Rain shower', ar: 'دُش مطري' }, kettle: { en: 'Kettle & tea tray', ar: 'غلاية وصينية شاي' }, towels: { en: 'Fresh towel sets', ar: 'مناشف جديدة' }, wardrobe: { en: 'Wardrobe', ar: 'خزانة ملابس' },
};
const abs = (p: string) => new URL(p, SITE.url + '/').href;
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'HotelRoom', name: `${name} — ${SITE.name.en}`, description: t(`rooms.${id}.desc`), containedInPlace: { '@id': `${SITE.url}/#hotel` } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home'), item: abs(path(lang, 'home')) },
    { '@type': 'ListItem', position: 2, name: t('nav.rooms'), item: abs(path(lang, 'rooms')) },
    { '@type': 'ListItem', position: 3, name, item: abs(path(lang, 'rooms', id)) } ] },
];
---
<Layout lang={lang} page="rooms" sub={id} title={`${name} — ${t('meta.rooms.title')}`} desc={t(`rooms.${id}.desc`)} jsonld={jsonld}>
  <section class="room-hero">
    <div class="wrap room-hero-in">
      <div class="room-intro">
        <p class="eyebrow"><a href={path(lang, 'rooms')}>{t('nav.rooms')}</a> · {digits(String(ROOMS.indexOf(room) + 1).padStart(2, '0'), lang)}</p>
        <h1>{name}</h1>
        <p class="lead">{t(`rooms.${id}.desc`)}</p>
        <p class="muted small">{t('rooms.stay')}</p>
        <div class="room-cta">
          <a class="btn btn-wa btn-lg" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /> {t('rooms.enquireFor', { room: name })}</a>
          <a class="btn btn-ghost" href={`${path(lang, 'enquire')}?room=${id}`}>{t('nav.enquire')} <Icon name="arrowRight" size={18} class="rtl-flip" /></a>
        </div>
      </div>
      <div class="room-photo frame rv">
        <Img id={room.hero} lang={lang} ratio="4 / 5" priority sizes="(min-width: 960px) 46vw, 100vw" widths={[480, 720, 940]} />
        <p class="caption">{(photo(room.hero).caption ?? photo(room.hero).alt)[lang]}</p>
      </div>
    </div>
  </section>

  <section class="section walk">
    <div class="wrap">
      <div class="section-head rv"><span class="num">{t('rooms.walk')}</span><h2>{name}</h2></div>
    </div>
    <ol class="walk-list">
      {walk.map((w, i) => (
        <li class={`walk-step rv rv-d${(i % 3) + 1}`}>
          <div class="walk-photo"><Img id={w.photo} lang={lang} ratio={i % 2 === 0 ? '4 / 5' : '4 / 3'} sizes="(min-width: 960px) 38vw, 78vw" /></div>
          <p><span class="num">{digits(String(i + 1).padStart(2, '0'), lang)}</span> {w.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section amen">
    <div class="wrap amen-in">
      <ul class="amen-list rv">
        {amen.map((a) => <li><Icon name={a.icon} size={26} /> <span>{amenLabel[a.key][lang]}</span></li>)}
      </ul>
      <div class="amen-text rv rv-d1">
        <h3>{t('rooms.bathroom')}</h3>
        <p>{t('rooms.bathroomText')}</p>
      </div>
    </div>
  </section>

  <section class="section others">
    <div class="wrap"><div class="section-head rv"><h2>{t('rooms.all')}</h2></div></div>
    <Filmstrip items={others.map((r) => r.hero)} lang={lang} id="others-strip" height={360} />
    <div class="wrap others-links rv">
      {others.map((r) => <a href={path(lang, 'rooms', r.id)}>{t(`rooms.${r.id}.name`)} <Icon name="arrowRight" size={16} class="rtl-flip" /></a>)}
    </div>
  </section>
</Layout>
<style>
  .room-hero { padding-top: calc(var(--header-h) + 32px); }
  .room-hero-in { display: grid; gap: 28px; }
  .room-intro { display: grid; gap: 14px; align-content: center; }
  .room-intro .eyebrow a { color: inherit; text-decoration: none; }
  .room-intro h1 { font-size: clamp(2.6rem, 9vw, 4.6rem); }
  .room-cta { display: grid; gap: 10px; justify-items: start; margin-top: 8px; }
  .room-photo .caption { margin-top: 12px; }
  @media (min-width: 960px) { .room-hero-in { grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; } .room-cta { grid-auto-flow: column; align-items: center; gap: 18px; } }

  .walk-list { list-style: none; margin: 0; padding: 0 var(--gutter); display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .walk-list::-webkit-scrollbar { display: none; }
  .walk-step { flex: none; width: 78vw; max-width: 420px; scroll-snap-align: start; display: grid; gap: 12px; }
  .walk-step p { margin: 0; font-family: var(--display); font-size: 1.2rem; color: var(--ink); display: flex; gap: 10px; align-items: baseline; }
  html[lang='ar'] .walk-step p { font-family: var(--sans); font-size: 1.05rem; }
  @media (min-width: 960px) {
    .walk-list { display: grid; grid-template-columns: repeat(12, 1fr); gap: 40px 32px; overflow: visible; max-width: var(--container); margin-inline: auto; padding-inline: var(--gutter); }
    .walk-step { width: auto; max-width: none; }
    .walk-step:nth-child(4n+1) { grid-column: 1 / 6; } .walk-step:nth-child(4n+2) { grid-column: 7 / 13; margin-top: 120px; }
    .walk-step:nth-child(4n+3) { grid-column: 2 / 7; margin-top: -40px; } .walk-step:nth-child(4n+4) { grid-column: 8 / 12; margin-top: 60px; }
  }
  .amen { background: var(--paper); }
  .amen-in { display: grid; gap: 32px; }
  .amen-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 18px 16px; }
  .amen-list li { display: flex; align-items: center; gap: 12px; color: var(--ink); }
  .amen-list :global(.icon) { color: var(--gold); flex: none; }
  .amen-text { display: grid; gap: 8px; }
  @media (min-width: 960px) { .amen-in { grid-template-columns: 1.2fr 1fr; gap: 64px; align-items: center; } .amen-list { grid-template-columns: repeat(3, 1fr); } }
  .others-links { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 24px; }
  .others-links a { text-decoration: none; font-weight: 600; color: var(--gold-text); display: inline-flex; align-items: center; gap: 6px; }
</style>
